# ---- Supabase ----
# From your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key (server-only, NEVER exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- OpenRouter (LLM) ----
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
# Any OpenRouter model id. Default = cheap + 1M context.
OPENROUTER_MODEL=google/gemini-2.5-flash

# ---- Deepgram (voice, Phase 2) ----
DEEPGRAM_API_KEY=your-deepgram-key

# ---- Google Drive backup (OPTIONAL) ----
# Leave blank to store originals only in Supabase Storage (free, default).
# To also back up originals to a Shared Drive, provide a service account + folder id.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GDRIVE_FOLDER_ID=your-shared-drive-folder-id

# ---- Admin access ----
# Passphrase to enter the /admin dashboard.
ADMIN_PASSPHRASE=change-me-to-a-strong-secret

# ---- App ----
# Public base URL used to build employee interview links (no trailing slash).
NEXT_PUBLIC_BASE_URL=http://localhost:3000
